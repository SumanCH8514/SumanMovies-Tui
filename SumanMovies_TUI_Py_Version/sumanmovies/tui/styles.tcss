/* SumanMovies TUI - Modern Catppuccin Mocha Styling */

Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

#banner {
    height: 6;
    content-align: center middle;
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#search-container {
    height: 3;
    padding: 0 2;
    margin-bottom: 1;
}

#search-input {
    border: tall #89b4fa;
    background: #181825;
    color: #cdd6f4;
}

#search-input:focus {
    border: tall #cba6f7;
    background: #11111b;
}

#deck-tabs {
    height: 3;
    dock: top;
    background: #181825;
    color: #a6adc8;
}

.deck-item-row {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    border: solid #313244;
    background: #181825;
}

.deck-item-row:hover {
    background: #313244;
    border: solid #cba6f7;
}

#results-grid {
    layout: grid;
    grid-size: 4;
    grid-gutter: 1 2;
    padding: 1 2;
    overflow-y: auto;
    height: 1fr;
}

.movie-card {
    height: 7;
    border: round #45475a;
    background: #181825;
    padding: 0 1;
}

.movie-card:hover {
    border: round #cba6f7;
    background: #313244;
}

.movie-card-selected {
    border: round #f38ba8;
    background: #313244;
}

.movie-card-title {
    text-style: bold;
    color: #89b4fa;
}

.movie-card-meta {
    color: #a6adc8;
}

/* Details Screen */
#details-container {
    padding: 1 3;
    overflow-y: auto;
}

#details-title {
    text-style: bold;
    color: #cba6f7;
    margin-bottom: 1;
}

#details-overview {
    color: #bac2de;
    margin-bottom: 1;
}

#streams-list {
    border: solid #45475a;
    background: #181825;
    height: 10;
    margin-top: 1;
}

/* Footer / Status Bar */
Footer {
    background: #11111b;
    color: #a6adc8;
}
